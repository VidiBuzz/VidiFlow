{
	"name": "directus-lexical-editor",
	"description": "Rich text editor interface for Directus using Lexical framework with React integration",
	"icon": "extension",
	"version": "1.0.5",
	"author": "FSA <easywayroot@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/yegoroot/directus-lexical-editor.git"
	},
	"homepage": "https://github.com/yegoroot/directus-lexical-editor#readme",
	"bugs": {
		"url": "https://github.com/yegoroot/directus-lexical-editor/issues"
	},
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-interface"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "interface",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": "^10.10.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "16.0.2",
		"typescript": "^5.9.3",
		"vue": "^3.5.22"
	},
	"dependencies": {
		"@lexical/code": "^0.37.0",
		"@lexical/html": "^0.37.0",
		"@lexical/link": "^0.37.0",
		"@lexical/list": "^0.37.0",
		"@lexical/react": "^0.37.0",
		"@lexical/rich-text": "^0.37.0",
		"lexical": "^0.37.0",
		"lexical-vue": "^0.12.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	}
}