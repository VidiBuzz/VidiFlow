{
  "name": "directus-extension-layout-cards-plus",
  "version": "0.1.17",
  "description": "Enhanced cards layout extension for Directus 11+ with video autoplay preview support",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-layout",
    "cards",
    "video-preview",
    "cards-plus"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "main": "index.js",
  "directus:extension": {
    "type": "layout",
    "path": "index.js",
    "source": "src/index.ts",
    "host": "^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify"
  },
  "dependencies": {
    "@directus/stores": "^1.0.6",
    "date-fns": "^4.1.0",
    "lodash": "^4.17.21",
    "sass": "^1.94.2",
    "utils": "link:@directus/utils",
    "vue-i18n": "^11.2.2"
  },
  "devDependencies": {
    "@directus/composables": "^11.2.7",
    "@directus/extensions-sdk": "^11.0.10",
    "@directus/format-title": "^12.0.1",
    "@directus/types": "^13.2.2",
    "@directus/utils": "^13.0.9",
    "@types/lodash": "^4.14.202",
    "@types/node": "^24.3.0",
    "typescript": "^5.0.0",
    "vue": "^3.3.0",
    "vue-router": "^4.5.1"
  }
}