# Copy to lex/android/keystore.properties and fill in.
# The real keystore must live OUTSIDE the repo; keystore.properties is gitignored.
# Generate once with:
#   keytool -genkeypair -v -keystore lexi-release.jks -keyalg RSA -keysize 4096 \
#           -validity 10000 -alias lexi
storeFile=C:/secure/lexi-release.jks
storePassword=CHANGE_ME
keyAlias=lexi
keyPassword=CHANGE_ME
