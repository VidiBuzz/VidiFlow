{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidiflow-cloud-agents",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [{ "name": "AGENT", "class_name": "VidiFlowAgent" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VidiFlowAgent"] }],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "vidismart"
    }
  ],

  "ai": { "binding": "AI" }
}
